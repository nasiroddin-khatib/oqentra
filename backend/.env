# Runtime
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=1

# Comma-separated exact frontend origins. Do not use * in production.
FRONTEND_ORIGINS=http://127.0.0.1,http://localhost
PUBLIC_SITE_URL=http://127.0.0.1

# PostgreSQL (local example). For AWS RDS, use the endpoint, database,
# username and password from your RDS instance. Never commit real values.
DATABASE_URL=postgresql://oqentra:admin123@oqentra.c5cmascsgtnk.ap-south-1.rds.amazonaws.com:5432/oqentra
DB_SSL=true
# For RDS production, set DB_SSL=true and provide the AWS RDS CA bundle path.
DB_SSL_CA_PATH=/etc/pki/tls/certs/global-bundle.pem
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Authentication: generate with: openssl rand -base64 48
JWT_SECRET=REPLACEWITHATLEAST32RANDOMCHARACTERSjsdfhjsdfjkdsfasdkfjh
JWT_EXPIRES_IN=8h

# Optional initial administrator. Created once if email is not already present.
ADMIN_NAME=OQENTRA Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=jhhkhkhjkhjjk43242323412564768dffdsdsdffd

# Optional AWS Secrets Manager support. If set, secret JSON may contain
# DATABASE_URL, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, etc.
AWS_REGION=ap-south-1
AWS_SECRET_ID=

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_PATH=/metrics
